{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar proyecto",
            "command": "C:\\TDM-GCC-64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}\\ArbolAVL.cpp",
                "${workspaceFolder}\\ArbolDesicion.cpp",
                "${workspaceFolder}\\ColaPacientes.cpp",
                "${workspaceFolder}\\ListaServicio.cpp",
                "${workspaceFolder}\\Paciente.cpp",
                "${workspaceFolder}\\main.cpp",
                "-o",
                "${workspaceFolder}\\hospital.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila todos los archivos fuente del proyecto."
        },
        {
            "type": "process",
            "label": "Ejecutar programa",
            "command": "${workspaceFolder}\\hospital.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Compilar y ejecutar",
            "dependsOn": [
                "Compilar proyecto",
                "Ejecutar programa"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}